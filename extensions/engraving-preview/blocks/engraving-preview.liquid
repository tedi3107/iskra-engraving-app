{% schema %}
{
"name": "Engraving preview",
"target": "section",
"settings": [
{ "type": "text", "id": "button_label", "label": "Button label", "default": "Personalize" },
{ "type": "text", "id": "edit_button_label", "label": "Button label (once something is typed)", "default": "Edit" },
{ "type": "text", "id": "quick_add_label", "label": "Quick add to cart button label", "default": "Add to Cart" },
{ "type": "text", "id": "confirm_label", "label": "Confirm button label", "default": "Add to Cart" },
{ "type": "text", "id": "label", "label": "Dialog title / input label", "default": "Personalize with engraving" },
{ "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Type your engraving..." },
{ "type": "header", "content": "Personalize button style" },
{ "type": "range", "id": "button_radius", "label": "Border radius (px)", "min": 0, "max": 40, "step": 1, "default": 8 },
{ "type": "color", "id": "button_bg", "label": "Background color", "default": "#ffffff" },
{ "type": "color", "id": "button_bg_hover", "label": "Background color (hover)", "default": "#16233d" },
{ "type": "color", "id": "button_text", "label": "Text color", "default": "#16233d" },
{ "type": "color", "id": "button_text_hover", "label": "Text color (hover)", "default": "#ffffff" },
{ "type": "color", "id": "button_bg_filled", "label": "Background color (after typing)", "default": "#16233d" },
{ "type": "color", "id": "button_text_filled", "label": "Text color (after typing)", "default": "#ffffff" },
{ "type": "header", "content": "Add to cart button style" },
{ "type": "range", "id": "quick_add_radius", "label": "Border radius (px)", "min": 0, "max": 40, "step": 1, "default": 8 },
{ "type": "color", "id": "quick_add_bg", "label": "Background color", "default": "#16233d" },
{ "type": "color", "id": "quick_add_bg_hover", "label": "Background color (hover)", "default": "#0e1729" },
{ "type": "color", "id": "quick_add_text", "label": "Text color", "default": "#ffffff" },
{ "type": "color", "id": "quick_add_text_hover", "label": "Text color (hover)", "default": "#ffffff" },
{ "type": "color", "id": "quick_add_border", "label": "Border color", "default": "#16233d" },
{ "type": "header", "content": "Fonts" },
{ "type": "paragraph", "content": "Font 1 and Font 2 are uploaded once for the whole store in the app's Font settings page — this block just renders whichever one each product's engraving zone is set to use." }
]
}
{% endschema %}
