{% liquid
assign shop_fonts = shop.metafields.engraving.fonts.value
assign zone = product.metafields.engraving.zone.value
assign img = product.featured_image
%}

{% if zone and img %}
<style>
  {% if shop_fonts.fontOne %}
  @font-face {
    font-family: "{{ shop_fonts.fontOne.familyName }}";
    src: url("{{ shop_fonts.fontOne.url }}");
    font-display: swap;
  }
  {% endif %}

  {% if shop_fonts.fontTwo %}
  @font-face {
    font-family: "{{ shop_fonts.fontTwo.familyName }}";
    src: url("{{ shop_fonts.fontTwo.url }}");
    font-display: swap;
  }
  {% endif %}
</style>

<engraving-preview class="engraving-preview" data-product-id="{{ product.id }}"
  data-edit-label="{{ block.settings.edit_button_label | default: 'Edit' | escape }}"
  data-storage-version="{{ 'engraving-preview.js' | asset_url | escape }}" {{ block.shopify_attributes }}>
  <style>
    #EngravingTrigger-{{ block.id }} {
      --btn-radius: {{ block.settings.button_radius | default: 8 }}px;
      --btn-bg: {{ block.settings.button_bg | default: '#ffffff' }};
      --btn-bg-hover: {{ block.settings.button_bg_hover | default: '#16233d' }};
      --btn-text: {{ block.settings.button_text | default: '#16233d' }};
      --btn-text-hover: {{ block.settings.button_text_hover | default: '#ffffff' }};
      --btn-bg-filled: {{ block.settings.button_bg_filled | default: '#16233d' }};
      --btn-text-filled: {{ block.settings.button_text_filled | default: '#ffffff' }};
    }
    #EngravingQuickAdd-{{ block.id }} {
      --quick-add-radius: {{ block.settings.quick_add_radius | default: 8 }}px;
      --quick-add-bg: {{ block.settings.quick_add_bg | default: '#16233d' }};
      --quick-add-bg-hover: {{ block.settings.quick_add_bg_hover | default: '#0e1729' }};
      --quick-add-text: {{ block.settings.quick_add_text | default: '#ffffff' }};
      --quick-add-text-hover: {{ block.settings.quick_add_text_hover | default: '#ffffff' }};
      --quick-add-border: {{ block.settings.quick_add_border | default: '#16233d' }};
    }
  </style>
