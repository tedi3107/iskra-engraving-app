  <dialog class="engraving-preview__dialog" id="EngravingDialog-{{ block.id }}">
    <button type="button" class="engraving-preview__close" id="EngravingClose-{{ block.id }}"
      aria-label="Close"><svg class="icon icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M18 6 6 18M6 6l12 12"></path>
      </svg></button>

    <div class="engraving-preview__dialog-body">
    <div class="engraving-preview__dialog-media">
    <div class="engraving-preview__stage" id="EngravingStage-{{ block.id }}" data-shape="{{ zone.shape }}"
      data-font-choice="{{ zone.fontChoice }}" data-uppercase-only="{{ zone.uppercaseOnly }}"
      data-font-one-family="{{ shop_fonts.fontOne.familyName }}"
      data-font-one-fallback="{{ shop_fonts.fontOne.fallback }}"
      data-font-two-family="{{ shop_fonts.fontTwo.familyName }}"
      data-font-two-fallback="{{ shop_fonts.fontTwo.fallback }}" data-one-font-size="{{ zone.fontOne.fontSize }}"
      data-one-x="{{ zone.fontOne.x }}" data-one-y="{{ zone.fontOne.y }}" data-one-width="{{ zone.fontOne.width }}"
      data-one-height="{{ zone.fontOne.height }}" data-one-center-x="{{ zone.fontOne.centerX }}"
      data-one-center-y="{{ zone.fontOne.centerY }}" data-one-radius="{{ zone.fontOne.radius }}"
      data-one-start-angle="{{ zone.fontOne.startAngle }}" data-one-arc-length="{{ zone.fontOne.arcLength }}"
      data-two-font-size="{{ zone.fontTwo.fontSize }}" data-two-x="{{ zone.fontTwo.x }}"
      data-two-y="{{ zone.fontTwo.y }}" data-two-width="{{ zone.fontTwo.width }}"
      data-two-height="{{ zone.fontTwo.height }}" data-two-center-x="{{ zone.fontTwo.centerX }}"
      data-two-center-y="{{ zone.fontTwo.centerY }}" data-two-radius="{{ zone.fontTwo.radius }}"
      data-two-start-angle="{{ zone.fontTwo.startAngle }}" data-two-arc-length="{{ zone.fontTwo.arcLength }}">
      <img class="engraving-preview__image" src="{{ img | image_url: width: 800 }}" alt="{{ img.alt | escape }}"
        width="{{ img.width }}" height="{{ img.height }}" loading="lazy" crossorigin="anonymous">

      <canvas class="engraving-preview__canvas" id="EngravingCanvas-{{ block.id }}"></canvas>
    </div>
    </div>

    <div class="engraving-preview__dialog-controls">
    <h2 class="engraving-preview__dialog-title">{{ product.title }}</h2>
    <script type="application/json" class="engraving-preview__variant-images" id="EngravingVariantImages-{{ block.id }}">
      {
        {% for variant in product.variants %}
          {% assign v_img = variant.featured_image | default: variant.image | default: img %}
          "{{ variant.id }}": {{ v_img | image_url: width: 800 | json }}{% unless forloop.last %},{% endunless %}
        {% endfor %}
      }
    </script>

    <script type="application/json" class="engraving-preview__variants-data" id="EngravingVariantsData-{{ block.id }}">
      [
        {% for variant in product.variants %}
          {
            "id": {{ variant.id | json }},
            "options": {{ variant.options | json }},
            "price": {{ variant.price | json }},
            "available": {{ variant.available | json }},
            "featured_media_id": {% if variant.featured_media %}{{ variant.featured_media.id | json }}{% elsif variant.featured_image %}{{ variant.featured_image.id | json }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    </script>

    {% unless product.has_only_default_variant %}
    <div class="engraving-preview__variant-picker" id="EngravingVariantPicker-{{ block.id }}">
      {% assign engraving_has_material = false %}
      {% assign engraving_has_size = false %}
      {% for option in product.options_with_values %}
        {% if option.name == 'Material' %}{% assign engraving_has_material = true %}{% endif %}
        {% if option.name == 'Size' %}{% assign engraving_has_size = true %}{% endif %}
      {% endfor %}

      {% if engraving_has_material or engraving_has_size %}
      <div class="engraving-preview__variant-row">
        {% for option in product.options_with_values %}
          {% if option.name == 'Material' or option.name == 'Size' %}
            <div class="engraving-preview__variant-option-group engraving-preview__variant-option-group--{{ option.name | handle }}">
              <span class="engraving-preview__variant-legend">
                {{ option.name }}{% if option.name == 'Material' %} <strong data-selected-label>{{ option.selected_value }}</strong>{% endif %}
              </span>
              <div class="engraving-preview__variant-pills engraving-preview__variant-pills--{{ option.name | handle }}"
                data-option-position="{{ forloop.index }}"
                data-option-name="{{ option.name | escape }}">
                {% for value in option.values %}
                  {% liquid
                    assign bgColor = nil
                    assign variantValue = nil
                    if option.name == 'Material'
                      for variantMaterial in product.metafields.custom.material.value
                        if variantMaterial.name == value
                          assign bgColor = variantMaterial.color
                        endif
                      endfor
                    elsif option.name == 'Size'
                      for variantSize in product.metafields.custom.size.value
                        if variantSize.size_name == value
                          assign variantValue = variantSize.size_value
                        endif
                      endfor
                    endif
                  %}
                  <button type="button"
                    class="engraving-preview__variant-pill{% if option.name == 'Material' %} engraving-preview__variant-pill--material{% elsif option.name == 'Size' %} engraving-preview__variant-pill--size{% endif %}"
                    data-option-position="{{ forloop.parentloop.index }}"
                    data-option-name="{{ option.name | escape }}"
                    data-value="{{ value | escape }}"
                    {% if option.name == 'Material' %}
                      aria-label="{{ value | escape }}"
                      {% if bgColor %}style="background-color: {{ bgColor }};"{% endif %}
                    {% elsif option.name == 'Size' and variantValue != blank %}
                      style="order: {{ variantValue | times: 2 | plus: 1 | replace: '.0', '' }}"
                    {% endif %}>
                    {% if option.name == 'Size' %}
                      {{ variantValue | default: value }}
                    {% endif %}
                  </button>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
      {% endif %}

      {% for option in product.options_with_values %}
        {% unless option.name == 'Material' or option.name == 'Size' %}
          <div class="engraving-preview__variant-option-group">
            <span class="engraving-preview__variant-legend">{{ option.name }}</span>
            <div class="engraving-preview__variant-pills" data-option-position="{{ forloop.index }}"
              data-option-name="{{ option.name | escape }}">
              {% for value in option.values %}
                <button type="button" class="engraving-preview__variant-pill"
                  data-option-position="{{ forloop.parentloop.index }}"
                  data-option-name="{{ option.name | escape }}"
                  data-value="{{ value | escape }}">
                  {{ value }}
                </button>
              {% endfor %}
            </div>
          </div>
        {% endunless %}
      {% endfor %}
    </div>
    {% endunless %}

    <div class="engraving-preview__input-row">
      <label for="EngravingInput-{{ block.id }}" class="engraving-preview__input-label">Engraving</label>
      <span class="engraving-preview__char-counter" id="EngravingCounter-{{ block.id }}">0/{{ zone.maxLength }}</span>
    </div>
    <input type="text" id="EngravingInput-{{ block.id }}" class="engraving-preview__input" name="properties[Engraving]"
      maxlength="{{ zone.maxLength }}" placeholder="{{ block.settings.placeholder }}"
      aria-label="{{ block.settings.label }}" autocomplete="off"
      {% if zone.uppercaseOnly %}style="text-transform: uppercase;"{% endif %}>

    {% if shop_fonts.fontOne or shop_fonts.fontTwo %}
    <span class="engraving-preview__label">Letter Type</span>
    <div class="engraving-preview__font-picker" id="EngravingFontPicker-{{ block.id }}">
      {% if shop_fonts.fontOne %}
      <label class="engraving-preview__font-option">
        <input type="radio" name="engraving-font-{{ block.id }}" value="one"
          {% if zone.fontChoice == 'one' %}checked{% endif %}>
        <span style="font-family:'{{ shop_fonts.fontOne.familyName }}', {{ shop_fonts.fontOne.fallback }};">A</span>
      </label>
      {% endif %}
      {% if shop_fonts.fontTwo %}
      <label class="engraving-preview__font-option">
        <input type="radio" name="engraving-font-{{ block.id }}" value="two"
          {% if zone.fontChoice == 'two' %}checked{% endif %}>
        <span style="font-family:'{{ shop_fonts.fontTwo.familyName }}', {{ shop_fonts.fontTwo.fallback }};">A</span>
      </label>
      {% endif %}
    </div>
    {% endif %}

    <button type="button" class="engraving-preview__confirm" id="EngravingConfirm-{{ block.id }}" disabled>
      <span class="engraving-preview__confirm-label">{{ block.settings.confirm_label }}</span>
      <span class="engraving-preview__confirm-price"></span>
    </button>

    <p class="engraving-preview__error" id="EngravingError-{{ block.id }}" role="alert" hidden>
      Something went wrong adding this to your cart — please try again.
    </p>
